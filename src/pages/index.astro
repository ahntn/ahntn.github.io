---
import Docs from '../layouts/Docs.astro';
import Plate from '../components/Plate.astro';
import PostRow from '../components/PostRow.astro';
import Callout from '../components/Callout.astro';
import { siteConfig } from '../../site.config';
import { getPosts, getProjects } from '../lib/content';
import { getReadingTime } from '../lib/reading-time';
import { absolute, withBase } from '../lib/url';

const projects = (await getProjects()).filter((p) => p.data.featured).slice(0, 3);
const posts = (await getPosts()).slice(0, 2);
const postTimes = await Promise.all(posts.map(getReadingTime));
const isDev = import.meta.env.DEV;

const headings = [
  ...(projects.length > 0 ? [{ slug: 'projects', text: 'Projects' }] : []),
  ...(posts.length > 0 || isDev ? [{ slug: 'writing', text: 'Latest writing' }] : []),
  { slug: 'contact', text: 'Contact' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteConfig.name,
  jobTitle: siteConfig.jobTitle,
  description: siteConfig.positioning,
  url: absolute('/'),
  address: { '@type': 'PostalAddress', addressRegion: 'Alberta', addressCountry: 'CA' },
  nationality: { '@type': 'Country', name: 'Canada' },
  worksFor: {
    '@type': 'Organization',
    name: 'Gambasoft',
    url: siteConfig.links.gambasoft,
  },
  sameAs: [siteConfig.links.github, siteConfig.links.linkedin],
};
---

<Docs
  path="/"
  crumbs={[{ label: 'Guide' }, { label: 'Overview' }]}
  headings={headings}
  jsonLd={jsonLd}
>
  <h1 style="font-size:clamp(2.75rem,8vw,4.75rem);margin-top:1.25rem">
    {siteConfig.name}
  </h1>
  <p class="lede">{siteConfig.positioning}</p>
  <div style="margin-top:1.5rem">
    <Callout title={siteConfig.openToWork}>
      <div class="actions">
        <a class="btn" href={siteConfig.links.linkedin} rel="noopener">
          Contact on LinkedIn →
        </a>
        <a class="btn btn-quiet" href={withBase('/resume')}>
          Resume
        </a>
      </div>
    </Callout>
  </div>

  {projects.length > 0 && (
    <section aria-labelledby="projects">
      <h2 id="projects">Projects</h2>
      <div class="plates">
        {projects.map((project, index) => (
          <Plate project={project} number={index + 1} />
        ))}
      </div>
      <p class="more">
        <a href={withBase('/projects')}>All projects</a>
      </p>
    </section>
  )}

  {(posts.length > 0 || isDev) && (
    <section aria-labelledby="writing">
      <h2 id="writing">Latest writing</h2>
      {posts.map((post, index) => (
        <PostRow post={post} readingTime={postTimes[index]} />
      ))}
      {posts.length === 0 && (
        <p class="todo-box">
          TODO: publish a first post (hidden in production while empty).
        </p>
      )}
      <p class="more">
        <a href={withBase('/writing')}>All writing</a>
      </p>
    </section>
  )}

  <section aria-labelledby="contact">
    <h2 id="contact">Contact</h2>
    <p class="prose">
      The best way to reach me is LinkedIn. I'm also the founder of
      <a href={siteConfig.links.gambasoft} rel="noopener">
        Gambasoft
      </a>
      {', where I build our own products and take on client work in web, cloud and AI.'}
    </p>
    <div class="actions" style="margin-top:1rem">
      <a class="btn" href={siteConfig.links.linkedin} rel="noopener">
        Contact on LinkedIn →
      </a>
      <a class="btn btn-quiet" href={withBase('/resume')}>
        Resume
      </a>
    </div>
  </section>
</Docs>
