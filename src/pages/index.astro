---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostItem from '../components/PostItem.astro';
import ContactLinks from '../components/ContactLinks.astro';
import Todo from '../components/Todo.astro';
import { siteConfig } from '../../site.config';
import { getPosts, getProjects } from '../lib/content';
import { getReadingTime } from '../lib/reading-time';
import { absolute, withBase } from '../lib/url';

const projects = (await getProjects()).filter((p) => p.data.featured).slice(0, 3);
const posts = (await getPosts()).slice(0, 2);
const postTimes = await Promise.all(posts.map(getReadingTime));
const isDev = import.meta.env.DEV;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteConfig.name,
  jobTitle: siteConfig.jobTitle,
  description: siteConfig.positioning,
  url: absolute('/'),
  address: { '@type': 'PostalAddress', addressRegion: 'Alberta', addressCountry: 'CA' },
  nationality: { '@type': 'Country', name: 'Canada' },
  worksFor: {
    '@type': 'Organization',
    name: 'Gambasoft',
    url: siteConfig.links.gambasoft,
  },
  sameAs: [siteConfig.links.github, siteConfig.links.linkedin],
};
---

<Base path="/" jsonLd={jsonLd}>
  <section class="py-12 sm:py-20">
    <p class="mb-4 font-mono text-sm text-muted">{siteConfig.location}</p>
    <h1 class="text-5xl font-semibold sm:text-7xl">{siteConfig.name}</h1>
    <p class="mt-6 max-w-2xl font-serif text-2xl leading-snug sm:text-3xl">
      {siteConfig.positioning}
    </p>
    <p class="mt-8 inline-flex items-center gap-2 rounded-full border border-line bg-surface px-4 py-2 text-sm">
      <span class="h-2 w-2 rounded-full bg-green-600" aria-hidden="true"></span>
      {siteConfig.openToWork}
    </p>
  </section>

  {projects.length > 0 && (
    <section class="py-10" aria-labelledby="featured">
      <div class="mb-6 flex items-baseline justify-between">
        <h2 id="featured" class="text-3xl font-semibold">
          Featured projects
        </h2>
        <a href={withBase('/projects')} class="text-sm underline">
          All projects
        </a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </section>
  )}

  {(posts.length > 0 || isDev) && (
    <section class="py-10" aria-labelledby="latest">
      <div class="mb-6 flex items-baseline justify-between">
        <h2 id="latest" class="text-3xl font-semibold">
          Latest writing
        </h2>
        <a href={withBase('/writing')} class="text-sm underline">
          All posts
        </a>
      </div>
      <div class="flex flex-col gap-8">
        {posts.map((post, index) => (
          <PostItem post={post} readingTime={postTimes[index]} />
        ))}
        {posts.length === 0 && (
          <Todo note="publish a first post (hidden in production while empty)." />
        )}
      </div>
    </section>
  )}

  <section class="py-10" id="contact" aria-labelledby="contact-title">
    <h2 id="contact-title" class="mb-4 text-3xl font-semibold">
      Contact
    </h2>
    <p class="mb-4 max-w-xl text-muted">
      The best way to reach me is LinkedIn. I'm also the founder of
      <a class="underline" href={siteConfig.links.gambasoft} rel="noopener">
        Gambasoft
      </a>
      , where I build our own products and take on client work in web, cloud and AI.
    </p>
    <ContactLinks />
  </section>
</Base>
