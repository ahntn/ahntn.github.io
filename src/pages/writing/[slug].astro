---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Docs from '../../layouts/Docs.astro';
import { formatDate, getPosts } from '../../lib/content';
import { absolute } from '../../lib/url';
import { siteConfig } from '../../../site.config';

export const getStaticPaths = async function getPaths() {
  const posts = await getPosts();
  return posts.map(function toPath(post) {
    return { params: { slug: post.id }, props: { post } };
  });
} satisfies GetStaticPaths;

const props = Astro.props;
const { post } = props;
const { data } = post;
const rendered = await render(post);
const { Content, headings } = rendered;
const toc = headings
  .filter((h) => h.depth === 2)
  .map((h) => ({ slug: h.slug, text: h.text }));
const minutes = rendered.remarkPluginFrontmatter?.readingTime ?? 1;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.description,
  datePublished: data.pubDate.toISOString(),
  dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
  author: { '@type': 'Person', name: siteConfig.name },
  mainEntityOfPage: absolute(`/writing/${post.id}`),
};
---

<Docs
  title={data.title}
  description={data.description}
  path={`/writing/${post.id}`}
  ogSlug={`writing-${post.id}`}
  type="article"
  jsonLd={jsonLd}
  noindex={data.draft}
  crumbs={[
    { label: 'Guide', href: '/' },
    { label: 'Writing', href: '/writing' },
    { label: data.title },
  ]}
  headings={toc}
>
  <h1>{data.title}</h1>
  <p class="label tabular">
    <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>·{' '}
    {minutes} min read
  </p>
  {data.tags.length > 0 && (
    <ul class="pills" aria-label="Tags" style="margin-top:0.75rem">
      {data.tags.map((tag) => (
        <li>{tag}</li>
      ))}
    </ul>
  )}
  <div class="prose" style="margin-top:2rem">
    <Content />
  </div>
</Docs>
