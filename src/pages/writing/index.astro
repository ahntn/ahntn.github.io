---
import Base from '../../layouts/Base.astro';
import PostItem from '../../components/PostItem.astro';
import Todo from '../../components/Todo.astro';
import { getPosts } from '../../lib/content';
import { getReadingTime } from '../../lib/reading-time';
import { withBase } from '../../lib/url';

const posts = await getPosts();
const times = await Promise.all(posts.map(getReadingTime));
---

<Base
  title="Writing"
  description="Notes on React, TypeScript, state machines and back-end work by Anh Nguyen."
  path="/writing"
>
  <h1 class="mt-8 text-5xl font-semibold">Writing</h1>
  <p class="mt-4 text-muted">
    <a href={withBase('/rss.xml')} class="underline">Subscribe via RSS</a>
  </p>
  <div class="mt-10 flex flex-col gap-10">
    {posts.map((post, index) => <PostItem post={post} readingTime={times[index]} />)}
    {posts.length === 0 && <Todo note="no published posts yet." />}
  </div>
</Base>
