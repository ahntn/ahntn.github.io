---
import Docs from '../../layouts/Docs.astro';
import PostRow from '../../components/PostRow.astro';
import { getPosts } from '../../lib/content';
import { getReadingTime } from '../../lib/reading-time';
import { withBase } from '../../lib/url';

const posts = await getPosts();
const times = await Promise.all(posts.map(getReadingTime));
---

<Docs
  title="Writing"
  description="Notes on React, TypeScript, state machines and back-end work by Anh Nguyen."
  path="/writing"
  crumbs={[{ label: 'Guide', href: '/' }, { label: 'Writing' }]}
>
  <h1>Writing</h1>
  <p class="prose">
    <a href={withBase('/rss.xml')}>Subscribe by RSS</a>
  </p>
  <div style="margin-top:2rem">
    {posts.map((post, index) => (
      <PostRow post={post} readingTime={times[index]} />
    ))}
    {posts.length === 0 && (
      <p class="prose">
        {import.meta.env.DEV ? (
          <span class="todo-box">TODO: no published posts yet.</span>
        ) : (
          'Nothing published yet.'
        )}
      </p>
    )}
  </div>
</Docs>
