---
import { readFileSync } from 'node:fs';
import Docs from '../layouts/Docs.astro';
import Timeline from '../components/Timeline.astro';
import SkillsTable from '../components/SkillsTable.astro';
import { siteConfig } from '../../site.config';
import { withBase } from '../lib/url';

// The committed PDF is a placeholder until it no longer contains the PLACEHOLDER marker.
const pdfIsPlaceholder = readFileSync('public/resume.pdf').includes('PLACEHOLDER');
const headings = [
  { slug: 'skills', text: 'Skills' },
  { slug: 'experience', text: 'Experience' },
];
---

<Docs
  title="Resume"
  description="Resume of Anh Nguyen, senior full-stack engineer: PDF download and a printable version."
  path="/resume"
  crumbs={[{ label: 'Guide', href: '/' }, { label: 'Resume' }]}
  headings={headings}
>
  <h1>Resume</h1>
  <p class="no-print" style="display:flex;gap:0.75rem;flex-wrap:wrap;margin-top:1rem">
    <a class="btn" href={withBase(siteConfig.resumePdf)} download>
      Download PDF
    </a>
    <button type="button" id="print-btn" class="btn btn-quiet">
      Print this page
    </button>
  </p>
  {pdfIsPlaceholder && (
    <p class="todo-box no-print" style="margin-top:1rem">
      TODO: replace public/resume.pdf with your real resume.
    </p>
  )}

  <section style="margin-top:2rem" aria-label="Summary">
    <p class="lede" style="max-width:40ch">
      {siteConfig.jobTitle}
    </p>
    <p class="prose">
      {siteConfig.location} · Canadian citizen ·{' '}
      {siteConfig.links.linkedin.replace('https://www.', '')} ·
      {siteConfig.links.github.replace('https://', '')}
    </p>
    <p class="prose" style="margin-top:0.75rem">
      {siteConfig.positioning} {siteConfig.openToWork}
    </p>
  </section>

  <h2 id="skills">Skills</h2>
  <SkillsTable />

  <h2 id="experience">Experience</h2>
  <Timeline />

  <script>
    document.getElementById('print-btn')?.addEventListener('click', function onClick() {
      window.print();
    });
  </script>
</Docs>
