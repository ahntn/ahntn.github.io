---
import Docs from '../layouts/Docs.astro';
import Timeline from '../components/Timeline.astro';
import SkillsTable from '../components/SkillsTable.astro';
import { siteConfig } from '../../site.config';

const headings = [
  { slug: 'skills', text: 'Skills' },
  { slug: 'experience', text: 'Experience' },
  { slug: 'elsewhere', text: 'Elsewhere' },
];
---

<Docs
  title="About"
  description="Senior full-stack engineer with 8+ years of experience: React and TypeScript first, now deepening Node.js and Python back ends."
  path="/about"
  crumbs={[{ label: 'Guide', href: '/' }, { label: 'About' }]}
  headings={headings}
>
  <h1>About</h1>
  <div class="prose">
    <p>
      I'm a senior full-stack engineer with 8+ years of experience. React and TypeScript
      come first for me, and I'm now deepening my Node.js and Python back-end work.
    </p>
    <p>
      I'm based in {siteConfig.location} and I'm a Canadian citizen. I'm looking for a
      full-time remote role. I also run{' '}
      <a href={siteConfig.links.gambasoft} rel="noopener">
        Gambasoft
      </a>
      {
        ', a company that builds its own products and does client work in web, cloud and AI.'
      }
    </p>
    <p class="todo-box">
      TODO: add 1-2 personal sentences: how you like to work, what you want next.
    </p>
  </div>

  <h2 id="skills">Skills</h2>
  <SkillsTable />

  <h2 id="experience">Experience</h2>
  <Timeline />

  <h2 id="elsewhere">Elsewhere</h2>
  <ul class="inline-list">
    <li>
      <a href={siteConfig.links.linkedin} rel="me noopener">
        LinkedIn
      </a>
    </li>
    <li>
      <a href={siteConfig.links.github} rel="me noopener">
        GitHub
      </a>
    </li>
    <li>
      <a href={siteConfig.links.gambasoft} rel="noopener">
        Gambasoft
      </a>
    </li>
  </ul>
</Docs>
