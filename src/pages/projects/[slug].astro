---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Docs from '../../layouts/Docs.astro';
import StatusMark from '../../components/StatusMark.astro';
import { formatDate, getProjects } from '../../lib/content';
import { withBase } from '../../lib/url';

export const getStaticPaths = async function getPaths() {
  const projects = await getProjects();
  return projects.map(function toPath(project) {
    return { params: { slug: project.id }, props: { project } };
  });
} satisfies GetStaticPaths;

const props = Astro.props;
const { project } = props;
const { data } = project;
const { Content, headings } = await render(project);
const toc = headings
  .filter((h) => h.depth === 2)
  .map((h) => ({ slug: h.slug, text: h.text }));
---

<Docs
  title={data.title}
  description={data.summary}
  path={`/projects/${project.id}`}
  ogSlug={`projects-${project.id}`}
  noindex={data.draft}
  crumbs={[
    { label: 'Guide', href: '/' },
    { label: 'Projects', href: '/projects' },
    { label: data.title },
  ]}
  headings={toc}
>
  <h1>{data.title}</h1>
  <p class="lede" style="max-width:40ch">
    {data.summary}
  </p>

  <table class="spec" style="margin-top:1.5rem">
    <tbody>
      <tr>
        <th scope="row">Version</th>
        <td>
          {data.version ?? (
            <span class="todo-box" data-todo>
              TODO: version
            </span>
          )}
        </td>
      </tr>
      <tr>
        <th scope="row">Last updated</th>
        <td class="tabular">
          {data.updated ? (
            <time datetime={data.updated.toISOString()}>{formatDate(data.updated)}</time>
          ) : (
            <span class="todo-box" data-todo>
              TODO: last updated
            </span>
          )}
        </td>
      </tr>
      <tr>
        <th scope="row">Status</th>
        <td>
          <StatusMark status={data.status} />
        </td>
      </tr>
      {data.role && (
        <tr>
          <th scope="row">Role</th>
          <td>{data.role}</td>
        </tr>
      )}
      {data.demo && (
        <tr>
          <th scope="row">Demo</th>
          <td>
            <a href={data.demo} rel="noopener">
              {data.demo}
            </a>
          </td>
        </tr>
      )}
      {data.code && (
        <tr>
          <th scope="row">Code</th>
          <td>
            <a href={data.code} rel="noopener">
              {data.code}
            </a>
          </td>
        </tr>
      )}
    </tbody>
  </table>

  {(data.image || data.video) && (
    <figure style="margin:2rem 0 0;max-width:var(--measure)">
      {data.video ? (
        <video
          controls
          preload="metadata"
          src={withBase(data.video)}
          style="width:100%;border:1px solid var(--rule)"
        />
      ) : (
        <img
          src={withBase(data.image ?? '')}
          alt={data.imageAlt ?? data.title}
          width="1200"
          height="750"
          loading="lazy"
          style="width:100%;height:auto;border:1px solid var(--rule)"
        />
      )}
    </figure>
  )}

  <div class="prose" style="margin-top:2rem">
    <Content />
  </div>
</Docs>
