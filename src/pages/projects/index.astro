---
import Docs from '../../layouts/Docs.astro';
import Plate from '../../components/Plate.astro';
import { getProjects } from '../../lib/content';

const projects = await getProjects();
---

<Docs
  title="Projects"
  description="Projects by Anh Nguyen, each written up as an architecture page: problem, architecture, stack, key decisions and what I learned."
  path="/projects"
  crumbs={[{ label: 'Guide', href: '/' }, { label: 'Projects' }]}
>
  <h1>Projects</h1>
  <p class="prose">
    Each app is a plate in this guide, written up as an architecture page. Code for my
    Gambasoft apps is private, so a project may have a demo and a write-up but no
    repository.
  </p>
  <div class="plates" style="margin-top:2rem">
    {projects.map((project, index) => (
      <Plate project={project} number={index + 1} />
    ))}
  </div>
  {projects.length === 0 && (
    <p class="prose" style="margin-top:2rem">
      {import.meta.env.DEV ? (
        <span class="todo-box">TODO: no published projects yet.</span>
      ) : (
        'Projects are coming soon.'
      )}
    </p>
  )}
</Docs>
