---
import { experience } from '../data/experience';

function isTodo(value: string) {
  return value.startsWith('TODO:');
}
---

<ol class="timeline">
  {experience.map(function renderItem(item) {
    return (
      <li>
        <h3>
          {isTodo(item.org) ? (
            <span class="todo-box" data-todo>
              {item.org}
            </span>
          ) : item.url ? (
            <a href={item.url} rel="noopener">
              {item.org}
            </a>
          ) : (
            item.org
          )}
        </h3>
        <p class="label">
          {isTodo(item.role) ? (
            <span class="todo-box" data-todo>
              {item.role}
            </span>
          ) : (
            item.role
          )}
          {' · '}
          {isTodo(item.period) ? (
            <span class="todo-box" data-todo>
              {item.period}
            </span>
          ) : (
            item.period
          )}
        </p>
        <p>{item.summary}</p>
        {item.bullets.length > 0 && (
          <ul>
            {item.bullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
        )}
      </li>
    );
  })}
</ol>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: var(--measure);
  }
  .timeline li:not(li li) {
    border-top: 1px solid var(--ink);
    padding: 1rem 0 1.5rem;
  }
  .timeline h3 {
    margin: 0 0 0.25rem;
    font-size: 1.375rem;
  }
  .timeline h3 a {
    text-decoration: none;
  }
  .timeline p + p {
    margin-top: 0.5rem;
  }
  .timeline ul {
    margin: 0.5rem 0 0;
    padding-left: 1.3rem;
    color: var(--muted);
  }
</style>
