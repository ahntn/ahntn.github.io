---
import { experience } from '../data/experience';
import Todo from './Todo.astro';

function isTodo(value: string) {
  return value.startsWith('TODO:');
}
function todoNote(value: string) {
  return value.replace(/^TODO:\s*/, '');
}
---

<ol class="relative ml-2 border-l border-line">
  {experience.map(function renderItem(item) {
    return (
      <li class="mb-10 ml-6">
        <span
          class="absolute -left-[5px] mt-2 h-2.5 w-2.5 rounded-full border border-accent bg-bg"
          aria-hidden="true"
        />
        <h3 class="text-xl font-semibold">
          {isTodo(item.org) ? (
            <Todo note={todoNote(item.org)} />
          ) : item.url ? (
            <a href={item.url} rel="noopener" class="no-underline hover:text-accent">
              {item.org}
            </a>
          ) : (
            item.org
          )}
        </h3>
        <p class="text-muted">
          {isTodo(item.role) ? <Todo note={todoNote(item.role)} /> : item.role}
          {' · '}
          {isTodo(item.period) ? <Todo note={todoNote(item.period)} /> : item.period}
        </p>
        <p class="mt-2">{item.summary}</p>
        {item.bullets.length > 0 && (
          <ul class="mt-2 list-disc pl-5 text-muted">
            {item.bullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
        )}
      </li>
    );
  })}
</ol>
