---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/url';
import ProjectKey from './ProjectKey.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  number: number;
}
const props = Astro.props;
const { project, number } = props;
const { data } = project;
const isDev = import.meta.env.DEV;
---

<article class="plate">
  {data.diagram ? (
    <figure class="figure">
      <img
        src={withBase(data.diagram)}
        alt={data.diagramAlt ?? `${data.title} architecture`}
        width="640"
        height="360"
        loading="lazy"
      />
      <figcaption>Fig. 1</figcaption>
    </figure>
  ) : (
    isDev && (
      <figure class="figure figure-empty">
        <span class="todo-box" data-todo>
          TODO: add `diagram` (Fig. 1)
        </span>
        <figcaption>Fig. 1</figcaption>
      </figure>
    )
  )}
  <h3>
    <a href={withBase(`/projects/${project.id}`)}>{data.title}</a>
    <span class="plate-no">No. {number}</span>
  </h3>
  <p>{data.summary}</p>
  <ProjectKey project={project} />
</article>
