---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/url';

interface Props {
  project: CollectionEntry<'projects'>;
}
const props = Astro.props;
const { project } = props;
const { data } = project;
---

<article
  class="group relative flex flex-col gap-3 rounded-lg border border-line bg-surface p-5 transition-colors hover:border-accent"
>
  <h3 class="text-xl font-semibold">
    <a href={withBase(`/projects/${project.id}`)} class="no-underline after:absolute after:inset-0">
      {data.title}
    </a>
    {
      data.draft && (
        <span class="ml-2 rounded bg-red-100 px-1.5 py-0.5 align-middle font-sans text-xs font-medium text-red-800">
          draft
        </span>
      )
    }
  </h3>
  <p class="text-muted">{data.summary}</p>
  {
    data.stack.length > 0 && (
      <ul class="mt-auto flex flex-wrap gap-2 pt-1" aria-label="Stack">
        {data.stack.map(function renderTag(tag) {
          return (
            <li class="rounded-full border border-line px-2.5 py-0.5 font-mono text-xs text-muted">
              {tag}
            </li>
          );
        })}
      </ul>
    )
  }
</article>
