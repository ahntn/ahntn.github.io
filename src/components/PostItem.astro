---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/content';
import { withBase } from '../lib/url';

interface Props {
  post: CollectionEntry<'writing'>;
  readingTime: number;
}
const props = Astro.props;
const { post, readingTime } = props;
const { data } = post;
---

<article class="flex flex-col gap-1">
  <h3 class="text-xl font-semibold">
    <a href={withBase(`/writing/${post.id}`)} class="no-underline hover:text-accent">
      {data.title}
    </a>
  </h3>
  <p class="text-sm text-muted">
    <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>·{' '}
    {readingTime} min read
    {data.tags.length > 0 && <span> · {data.tags.join(', ')}</span>}
  </p>
  <p>{data.description}</p>
</article>
