---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/content';
import { withBase } from '../lib/url';

interface Props {
  post: CollectionEntry<'writing'>;
  readingTime: number;
}
const props = Astro.props;
const { post, readingTime } = props;
const { data } = post;
---

<article class="post-row">
  <h3>
    <a href={withBase(`/writing/${post.id}`)}>{data.title}</a>
  </h3>
  <p class="label tabular meta">
    <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>
    {' · '}
    {readingTime} min read{data.tags.length > 0 ? ` · ${data.tags.join(', ')}` : ''}
  </p>
  <p>{data.description}</p>
</article>

<style>
  .post-row {
    border-top: 1px solid var(--ink);
    padding: 0.9rem 0 1.4rem;
  }
  .meta {
    margin: 0 0 0.4rem;
  }
  .post-row h3 {
    margin: 0 0 0.2rem;
    font-size: 1.375rem;
  }
  .post-row h3 a {
    text-decoration: none;
    display: inline-block;
    padding-block: 0.4rem;
  }
</style>
