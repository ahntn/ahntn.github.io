---
import { skillGroups } from '../data/skills';
---

<div class="grid gap-4 sm:grid-cols-3">
  {
    skillGroups.map(function renderGroup(group) {
      return (
        <section class="rounded-lg border border-line bg-surface p-5">
          <h3 class="text-xl font-semibold">{group.depth}</h3>
          <p class="mb-3 text-sm text-muted">{group.blurb}</p>
          <ul class="flex flex-wrap gap-2">
            {group.skills.map((skill) => (
              <li class="rounded-full border border-line px-2.5 py-0.5 font-mono text-xs">
                {skill}
              </li>
            ))}
          </ul>
        </section>
      );
    })
  }
</div>
