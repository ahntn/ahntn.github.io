---
import '../styles/global.css';
import { siteConfig } from '../../site.config';
import { absolute, withBase } from '../lib/url';
import ThemeToggle from '../components/ThemeToggle.astro';
import ContactLinks from '../components/ContactLinks.astro';

interface Props {
  title?: string;
  description?: string;
  /** Path of this page, e.g. "/about". Used for canonical + OG. */
  path: string;
  /** Slug for the generated social image. Defaults to the site card. */
  ogSlug?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}

const props = Astro.props;
const {
  title,
  description = siteConfig.description,
  path,
  ogSlug = 'default',
  type = 'website',
  jsonLd,
  noindex = false,
} = props;

const fullTitle = title ? `${title} · ${siteConfig.name}` : siteConfig.title;
const canonical = absolute(path === '/' ? '/' : path);
const ogImage = absolute(`/og/${ogSlug}.png`);

const nav = [
  { href: '/projects', label: 'Projects' },
  { href: '/writing', label: 'Writing' },
  { href: '/about', label: 'About' },
  { href: '/resume', label: 'Resume' },
];
const current = Astro.url.pathname.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteConfig.name} — Writing`}
      href={withBase('/rss.xml')}
    />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <script is:inline>
      (function () {
        let theme;
        try {
          theme = localStorage.getItem('theme');
        } catch {
          theme = null;
        }
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body class="antialiased">
    <a href="#main" class="skip-link">
      Skip to content
    </a>
    <header class="no-print mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-4 gap-y-3 px-4 py-5 sm:px-6">
      <a
        href={withBase('/')}
        class="font-serif text-xl font-semibold whitespace-nowrap no-underline"
      >
        {siteConfig.name}
      </a>
      <div class="flex items-center gap-3 sm:gap-5">
        <nav aria-label="Main">
          <ul class="flex gap-3 text-sm sm:gap-5 sm:text-base">
            {nav.map(function renderItem(item) {
              const active =
                current === withBase(item.href) ||
                current.startsWith(`${withBase(item.href)}/`);
              return (
                <li>
                  <a
                    href={withBase(item.href)}
                    class:list={[
                      'no-underline hover:text-accent',
                      active ? 'text-accent' : 'text-muted',
                    ]}
                    aria-current={active ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
        <ThemeToggle />
      </div>
    </header>

    <main id="main" class="mx-auto max-w-5xl px-4 pb-16 sm:px-6">
      <slot />
    </main>

    <footer class="no-print border-t border-line">
      <div class="mx-auto flex max-w-5xl flex-col gap-4 px-4 py-8 text-sm text-muted sm:px-6">
        <ContactLinks />
        <p>
          {siteConfig.name} · {siteConfig.location} · Canadian citizen ·
          <a class="underline" href={withBase('/rss.xml')}>
            RSS
          </a>
        </p>
      </div>
    </footer>
  </body>
</html>
